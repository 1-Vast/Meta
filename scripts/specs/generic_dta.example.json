{
  "name": "example-dta",
  "input": {
    "path": "dataset/raw/dta/example.csv",
    "delimiter": ",",
    "columns": {
      "smiles": "smiles",
      "sequence": "sequence",
      "label": "affinity",
      "relation": "relation",
      "gamma": "endpoint",
      "context": "assay_context"
    }
  },
  "label": {
    "transform": "paffinity",
    "unit_to_molar": 1e-9,
    "allowed_relations": ["="],
    "normalization": {"mode": "explicit_affine", "min": 3.0, "max": 12.0}
  },
  "split": {
    "salt": "MetaSieve-DTA/v1",
    "fractions": {"train": 0.6, "val": 0.15, "test": 0.25}
  },
  "duplicates": {"label_tolerance": 0.25, "aggregate": "median", "on_conflict": "fail"}
}
