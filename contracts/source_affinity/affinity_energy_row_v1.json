{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MetaSieve.AffinityEnergyRow.v1",
  "type": "object",
  "required": [
    "schema",
    "chembl_release",
    "activity_id",
    "assay_chembl_id",
    "document_chembl_id",
    "molecule_chembl_id",
    "target_chembl_id",
    "target_component_id",
    "protein_sequence",
    "protein_sequence_sha256",
    "canonical_smiles",
    "standard_inchi_key",
    "ligand_connectivity_key",
    "endpoint_family",
    "standard_relation",
    "standard_value",
    "standard_units",
    "p_affinity",
    "assay_context",
    "assay_context_sha256",
    "task_id",
    "task_keys"
  ],
  "properties": {
    "schema": {"const": "MetaSieve.AffinityEnergyRow.v1"},
    "chembl_release": {"const": "37"},
    "activity_id": {"type": "integer"},
    "assay_chembl_id": {"type": "string", "minLength": 1},
    "document_chembl_id": {"type": ["string", "null"]},
    "molecule_chembl_id": {"type": "string", "minLength": 1},
    "target_chembl_id": {"type": "string", "minLength": 1},
    "target_component_id": {"type": "integer"},
    "protein_sequence": {"type": "string", "pattern": "^[A-Z]+$"},
    "protein_sequence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_smiles": {"type": "string", "minLength": 1},
    "standard_inchi_key": {"type": "string", "minLength": 14},
    "ligand_connectivity_key": {"type": "string", "pattern": "^[A-Z]{14}$"},
    "endpoint_family": {"enum": ["Ki", "Kd"]},
    "standard_relation": {"const": "="},
    "standard_value": {"type": "number", "exclusiveMinimum": 0},
    "standard_units": {"enum": ["M", "mM", "uM", "um", "µM", "nM", "pM", "fM"]},
    "p_affinity": {"type": "number"},
    "assay_context": {"type": "object"},
    "assay_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_keys": {"type": "array", "minItems": 4, "maxItems": 4}
  },
  "additionalProperties": true
}
