# Python and test runtime
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_cycle_*/
.pytest_tmp*/
.tmp_pytest_*/
.coverage
htmlcov/

# Editors and local agents
.vscode/
.idea/
.claude/

# Local secrets and machine-specific remote configuration
.env
.env.*
config/remote/ssh_config
config/remote/hosts.json
config/remote/keys/
config/remote/sync_manifest.txt
LOCAL_RETENTION.md

# Downloaded third-party tools and model caches
tools/
!tools/
tools/**
!tools/README.md
!tools/__init__.py
!tools/research/
!tools/research/**
!tools/tests/
!tools/tests/**
weights/**
!weights/README.md

# Raw and processed datasets are not redistributed through Git. Keep only
# provenance, license, checksum, warning, and manifest files.
dataset/**
!dataset/**/
!dataset/**/README.md
!dataset/**/LICENSE
!dataset/**/LICENSE.*
!dataset/**/checksums.txt
!dataset/**/DO_NOT_USE_FOR_STRICT_EVALUATION.txt
!dataset/**/*manifest*.json

# Bytecode caches are never evidence. The `!tools/**` re-includes above would
# otherwise re-admit them (a later pattern wins), so exclude them again here.
tools/**/__pycache__/
tools/**/*.py[cod]

# Generic local residue
*.log
*.tmp
*.bak
Thumbs.db
.DS_Store

# Experiment payloads can be regenerated from JSON manifests/checksums.
report/**/checkpoints/
report/**/*.pt
report/**/*.jsonl.gz
archive/**/ephemeral_quarantine/
**/checkpoints/
*.pt
*.npz
*.jsonl.gz
